# Frontend environment configuration.
# Copy to `.env` (gitignored) and adjust as needed. All Vite-exposed vars must
# be prefixed with VITE_.

# Base URL for the MaintainIQ API. Leave unset in dev (the Vite proxy forwards
# /api -> http://localhost:8000) and in prod (FastAPI serves this SPA from the
# same origin). Override only when the API lives on a different host.
# VITE_API_BASE_URL=http://localhost:8000/api

# --- M6 (streaming ingestion) placeholder — not used yet ---
# When the live MQTT ingestion path lands, broker credentials belong in the
# backend's environment, NOT here (never expose secrets to the browser bundle).
# Documented here only so the convention is discoverable:
#   MAINTAINIQ_MQTT_URL=
#   MAINTAINIQ_MQTT_USERNAME=
#   MAINTAINIQ_MQTT_PASSWORD=
