# Copy to .env and adjust as needed. Nothing here is required to build/run —
# the app currently has no external services, auth, or API keys.

# Host port that maps to the container's uvicorn port (8000).
APP_PORT=8000

# --- M6 (planned): MQTT telemetry ingestion --------------------------------
# Not yet consumed by any code -- placeholders for the upcoming MQTT-based
# ingestion path (see IMPLEMENTATION_PLAN.md). Fill in once that milestone
# wires up a broker connection.
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
