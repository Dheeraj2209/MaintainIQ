# Copy to .env and adjust as needed. The defaults below are the docker-compose
# dev stack (Mailpit for mail, no auth, no TLS), so `docker compose up` works
# with this file copied verbatim. Only the JWT secret and the SMTP block need
# real values before anyone outside your machine uses the app.

# Host port that maps to the container's uvicorn port (8000).
APP_PORT=8000

# --- Auth ------------------------------------------------------------------
# Signing key for the session JWTs (src/auth/). Leave unset in dev to use the
# built-in development key; set a long random value in any shared deployment,
# because anyone who knows it can mint an admin session.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Email alert paging ----------------------------------------------------
# Where alert emails are sent from when a prediction opens or escalates an
# alert (src/notifications/). Admins and supervisors are paged; operators are
# not. Defaults target the Mailpit container from docker-compose.yml, whose
# web inbox is on http://localhost:8025 — mail is captured there, never
# delivered, which is what you want in dev.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=alerts@maintainiq.local

# Credentials. Leave both empty for Mailpit (it accepts unauthenticated mail);
# login is attempted only when both are set. For Gmail/Outlook use an app
# password, not the account password.
SMTP_USER=
SMTP_PASSWORD=

# Transport security — set exactly one for a real provider, neither for
# Mailpit. They are mutually exclusive: STARTTLS upgrades a plaintext
# connection (typically port 587), SSL wraps the socket from the start
# (typically port 465).
SMTP_STARTTLS=
SMTP_SSL=

# Socket timeout in seconds. Kept short because a hung mail server must not
# stall the prediction worker that triggered the page.
SMTP_TIMEOUT=5

# Example: Gmail
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_STARTTLS=1
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<16-char app password>
#   SMTP_FROM=you@gmail.com

# --- M6: live telemetry over MQTT ------------------------------------------
# Contract: design/M6_LIVE_TELEMETRY.md section 7 (src/telemetry/config.py).
# Leave MQTT_BROKER_HOST empty to disable live ingest -- the app then runs
# exactly as before (dataset backfill, replay, /demo). The defaults below
# point a host-side dev process (`MQTT_BROKER_HOST=localhost just serve`) at
# the Mosquitto container started by `just broker`; inside docker compose the
# app is pointed at the `mosquitto` service regardless of these values.
MQTT_BROKER_HOST=
# 1883 = plain MQTT (dev broker). Use 8883 with MQTT_TLS=1; if MQTT_TLS=1 and
# this is left empty the port defaults to 8883.
MQTT_BROKER_PORT=1883

# Credentials -- used only when BOTH are set. The dev broker
# (deploy/mosquitto/mosquitto.conf) allows anonymous clients.
MQTT_USERNAME=
MQTT_PASSWORD=

# TLS: 1 to enable; MQTT_CA_CERT optionally points at a CA bundle (PEM) for
# a broker certificate the system store does not trust.
MQTT_TLS=0
MQTT_CA_CERT=

# Fixed client id + persistent session (clean_session=False), so the broker
# queues QoS-1 telemetry while the app is down and delivers it on reconnect.
# Must be unique per running app instance.
MQTT_CLIENT_ID=maintainiq-ingest

# Topic namespace: {prefix}/telemetry/{machine_id}, {prefix}/status/{device_id},
# {prefix}/alerts/{machine_id}. Simulator and firmware must use the same one.
MQTT_TOPIC_PREFIX=maintainiq/v1

# 1 = create unknown machines on their first snapshot; 0 = reject them with
# error 'unknown machine'.
MQTT_AUTO_REGISTER=1

# Bounded hand-off queue between the MQTT network thread and the ingest
# worker; overflowing messages are dropped and counted (queue_overflows).
MQTT_INGEST_QUEUE_MAX=256

# Host port the Mosquitto container publishes (Docker only).
MQTT_PORT=1883
# Host interface that port is bound to (Docker only). 127.0.0.1 keeps the
# anonymous dev broker off the LAN; set 0.0.0.0 so ESP32 nodes on an
# ISOLATED bench network can reach it.
MQTT_BIND=127.0.0.1
# Broker port the app CONTAINER connects to inside the compose network
# (Docker only; host-side processes use MQTT_BROKER_PORT). 8883 with MQTT_TLS=1.
MQTT_COMPOSE_BROKER_PORT=1883

# --- Background jobs / device health ----------------------------------------
# design/2026-10-06-device-health-design.md. Tick of the in-process background
# scheduler, in seconds. 0 or empty = no background jobs, so no sensor-node
# silence alerting. 5 is a good value. Left EMPTY here on purpose: an empty
# value keeps host-side dev processes off, while docker-compose.yml turns an
# empty/unset value into 5 (the compose stack always runs MQTT ingest). Set 0
# to switch it off in compose too.
MAINTAINIQ_SWEEP_INTERVAL_S=
# Seconds the MQTT connection must have been up, without a break, before the
# silence watchdog may open or resolve incidents. Covers the retained-status
# replay and queued backlog right after a (re)connect, which would otherwise
# make live nodes look silent. Raise it for nodes with long heartbeats.
DEVICE_SILENT_GRACE_S=30

# --- Alert paging escalation ---------------------------------------------------
# design/2026-10-07-work-orders-escalation-design.md. While an open alert stays
# unacknowledged and has no active work order, the background scheduler (needs
# MAINTAINIQ_SWEEP_INTERVAL_S > 0) re-pages supervisors after L1 minutes and then
# admins after L2 minutes, measured from when the alert was created. Both must
# be positive, and L2 greater than L1; otherwise both defaults are used.
# ESCALATION_L1_MINUTES=15
# ESCALATION_L2_MINUTES=30

# --- Web Push (mobile operator view) -------------------------------------------
# design/2026-10-07-mobile-operator-pwa-design.md. Push is off unless both keys
# are set and valid; email is unaffected either way. Generate a pair with:
#   python -m src.notifications.push --generate-vapid
# VAPID_PRIVATE_KEY is a secret. VAPID_SUBJECT defaults to mailto:$SMTP_FROM;
# set a real address in production (Apple rejects unresolvable subjects).
# PUSH_ALLOWED_HOSTS replaces the default push-service host allowlist.
# Push needs HTTPS (or localhost) - see README "Mobile & push (PWA)".
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# PUSH_ALLOWED_HOSTS=fcm.googleapis.com,android.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,notify.windows.com,push.apple.com
