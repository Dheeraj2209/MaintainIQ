# Microsoft Office temporary lock files
~$*

# Operating-system metadata
Thumbs.db
Desktop.ini

# Editor and local workspace settings
.vscode/
.idea/
*.tmp
*.bak

# Downloaded package dependencies and build caches
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# Generated build artifacts (pptx exports, inspect logs, etc.) — not source design docs.
# Anchored to root so it doesn't also match research/**/outputs/, which holds
# committed reference data (cached feature CSVs), not disposable build output.
/outputs/

# Runtime SQLite DB produced by src/training/run_pipeline.py — regenerate by
# re-running the pipeline, not a source artifact to track.
/maintainiq.db

# Docker bind-mount target for the container's copy of maintainiq.db
# (see docker-compose.yml).
/data/

# Frontend (React/Vite) build output and local env. node_modules is covered
# above; dist is regenerated by `npm run build`, and .env holds local config
# (copy from frontend/.env.example).
frontend/dist/
.env
.env.local
frontend/.env
frontend/.env.local
